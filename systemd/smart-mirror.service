[Unit]
Description=Smart Mirror Pi
After=graphical-session.target
Wants=graphical-session.target
# Never permanently give up: this is an unattended retail kiosk, so a dark
# mirror that needs someone on-site to clear a failed unit is worse than a
# bounded retry loop.  StartLimitIntervalSec=0 disables the crash-loop give-up;
# RestartSec below bounds the retry rate so a genuine crash-loop can't burn CPU.
StartLimitIntervalSec=0

[Service]
Type=simple

# Qt / display environment
Environment=WAYLAND_DISPLAY=wayland-0
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=wayland;xcb
Environment=PYTHONUNBUFFERED=1

# Adjust to your actual install path (setup_autostart.sh patches this automatically)
WorkingDirectory=/home/pi/smart_mirror_pi
ExecStart=/home/pi/smart_mirror_pi/scripts/run.sh

# ── Restart policy ────────────────────────────────────────────────────────────
# Restart=always (not on-failure): a clean exit — e.g. Ctrl+Q, a quit from the
# UI, or exit(0) on an unhandled-but-caught path — must NOT leave the mirror
# dark on an unattended kiosk; bring it back up regardless of exit code.
# RestartSec spaces out retries so a crash-loop is bounded (~1 start / 5s).
Restart=always
RestartSec=5

# ── Logging ───────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-mirror

[Install]
WantedBy=graphical-session.target
